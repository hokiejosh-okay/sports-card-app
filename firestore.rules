rules_version = '2';

// CardVault Firestore rules (spec §6).
// A user may only touch docs where ownerId == their uid, AND only if a
// users/{uid} allowlist doc exists (created by the admin in the console).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Allowlisted = signed in AND has a users/{uid} doc.
    function allowlisted() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function ownsExisting() {
      return resource.data.ownerId == request.auth.uid;
    }
    function ownsIncoming() {
      return request.resource.data.ownerId == request.auth.uid;
    }

    // ---- users/{uid} — the allowlist. Managed from the Firebase console only. ----
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid; // needed for the client allowlist check
      allow write: if false;
    }

    // ---- cards ----
    match /cards/{cardId} {
      function validCard(d) {
        return d.ownerId is string
          && d.photos.front.path is string && d.photos.front.url is string
          && d.photos.back.path is string && d.photos.back.url is string
          && d.player is string && d.player.size() > 0
          && d.sport in ['baseball','basketball','football','hockey','soccer','golf','wrestling','mma-boxing','racing','other']
          && d.graded is bool
          // Controlled lists (spec §5) — enforced WHEN PRESENT so older docs that
          // predate a field aren't made uneditable by the whole-doc update rule.
          // Values must match data/lists.js exactly (case included).
          // brand: any of the controlled brands, incl "Other".
          && (!('brand' in d) || d.brand in ['Topps','Panini','Upper Deck','Bowman','Fleer','Donruss','Leaf','Score','Other'])
          // condition: a controlled condition, or null (graded cards and older raw cards).
          //   parallel is intentionally NOT constrained (free-entry by design).
          && (!('condition' in d) || d.condition == null
              || d.condition in ['Gem Mint','Mint','Near Mint-Mint','Near Mint','Excellent','Very Good','Good','Poor'])
          // When graded: grading.company from the controlled list (incl "Other"),
          // grade a number 1–10. gradeLabel is free text and is not constrained.
          && (d.graded == false || (
                d.grading.company in ['PSA','BGS','SGC','CGC','CSG','HGA','TAG','Other']
                && d.grading.grade is number && d.grading.grade >= 1 && d.grading.grade <= 10
             ));
      }

      allow read:   if allowlisted() && ownsExisting();
      allow create: if allowlisted() && ownsIncoming() && validCard(request.resource.data);
      allow update: if allowlisted() && ownsExisting() && ownsIncoming() && validCard(request.resource.data);
      allow delete: if allowlisted() && ownsExisting();

      // value history (written from Phase 2 on)
      match /valueHistory/{snapId} {
        allow read, write: if allowlisted()
          && get(/databases/$(database)/documents/cards/$(cardId)).data.ownerId == request.auth.uid;
      }
    }

    // ---- intake (Phase 1) — the resumable AI-seeding queue (spec §5) ----
    // A pending front/back pair awaiting Claude vision. The client creates and
    // updates its own rows; the analyzeIntake Function (Admin SDK) bypasses
    // these rules to write aiSuggested/aiConfidence/sideCheck/status back.
    match /intake/{intakeId} {
      function validIntake(d) {
        return d.ownerId is string
          && d.photos.front.path is string && d.photos.front.url is string
          && d.photos.back.path is string && d.photos.back.url is string
          && d.status in ['uploaded','analyzing','ready','check','error','confirmed','discarded']
          // Optional marker set by the re-analyze flow (transient row that copies
          // an existing card's photos). When present it must be a string.
          && (!('reanalyzeOf' in d) || d.reanalyzeOf is string);
      }

      allow read:   if allowlisted() && ownsExisting();
      allow create: if allowlisted() && ownsIncoming() && validIntake(request.resource.data);
      allow update: if allowlisted() && ownsExisting() && ownsIncoming() && validIntake(request.resource.data);
      allow delete: if allowlisted() && ownsExisting();
    }
  }
}
